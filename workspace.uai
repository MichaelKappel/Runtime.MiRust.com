project_name: Runtime.MiRust.com
status: retired_redirect_package
updated_utc: 2026-07-02T00:00:00Z

canonical_developer_portal:
  url: https://tinyrustlm.mirust.com/developer-portal/
  role: Current TinyRustLM developer documentation portal.

current_app:
  url: https://tinyrustlm.com/
  role: Browser-local Rust/WASM app.

preserved_archive:
  index: https://tinyrustlm.mirust.com/docs/runtime-portal/index.md
  manifest: https://tinyrustlm.mirust.com/docs/runtime-portal/MANIFEST.md
  local_copy: E:\Source\Rust\TinyRustLM.MiRust.com\docs\runtime-portal\

deployment_gate:
  instruction: Deploy this package only to the verified runtime.mirust.com web root.
  warning: The FileZilla profile named Runtime.MiRust.com currently uses the TinyRustLM.MiRust.com FTP username and must not be used to clear or overwrite Runtime.

behavior:
  root: Redirect to TinyRustLM.MiRust.com developer portal.
  docs: Redirect old /docs/* routes into the preserved runtime archive.
  machine_exports: Redirect llms.txt and llms-full.txt to current TinyRustLM.MiRust.com exports.

boundaries:
  - Runtime.MiRust.com is no longer a separate documentation authority.
  - TinyRustLM.MiRust.com is the current developer documentation portal.
  - TinyRustLM.com is the current public browser-local app.
  - Project servers do not run user model bytes.
  - Project servers do not serve runnable user model bytes.
