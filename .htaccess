Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

RewriteEngine On
RewriteBase /

# This is the sole public static file. Every other request, including a stale
# file left by an overlay deployment, must cross the same bounded path parser.
RewriteCond %{REQUEST_METHOD} =GET [OR]
RewriteCond %{REQUEST_METHOD} =HEAD
RewriteCond %{THE_REQUEST} "\s/assets/css/redirect\.css(?:\?|[[:space:]])"
RewriteRule ^assets/css/redirect\.css$ - [END]
RewriteRule ^ index.php [END,QSA]

<IfModule mod_headers.c>
  # Remove application/server duplicates before assigning one status-specific
  # robots policy. Errors, including the retired route, never advertise links.
  Header onsuccess unset X-Robots-Tag
  Header always unset X-Robots-Tag
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_STATUS} >= 400"
  Header always set X-Robots-Tag "noindex, follow" "expr=%{REQUEST_STATUS} < 400"

  Header onsuccess unset X-Content-Type-Options
  Header always unset X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"

  # PHP supplies the terminal response policy when mod_headers is absent. When
  # it is present, collapse any handler-added value to one exact field.
  Header onsuccess unset Cache-Control "expr=%{REQUEST_STATUS} >= 400"
  Header always unset Cache-Control "expr=%{REQUEST_STATUS} >= 400"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} >= 400"

  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'"
</IfModule>
